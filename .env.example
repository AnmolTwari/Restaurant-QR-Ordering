# ========================================================
# Root Environment Template
# Copy to .env for local overrides (never commit real .env)
# ========================================================

# Node Environment
NODE_ENV=development

# PostgreSQL configuration (matches infra/docker-compose.yml)
POSTGRES_USER=restaurant_admin
POSTGRES_PASSWORD=restaurant_secret_dev
POSTGRES_DB=restaurant_saas_db
POSTGRES_PORT=5432

# Database connection URL for API & Prisma
DATABASE_URL=postgresql://restaurant_admin:restaurant_secret_dev@localhost:5432/restaurant_saas_db?schema=public

# Server Ports & URLs
PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication & Session Security
# Generate using: openssl rand -base64 32
JWT_SECRET=dev-jwt-super-secret-key-change-in-production-min-32-chars

# Payment Gateway (Razorpay - Test / Production credentials)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_razorpay_webhook_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
