// Prisma Schema for QR Restaurant Ordering SaaS
// Source of truth: PROJECT_BRIEF.md

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// Enums
// ----------------------------------------------------

enum UserRole {
  OWNER
  MANAGER
  KITCHEN
  WAITER
  CASHIER
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum OrderItemStatus {
  ACTIVE
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  PARTIALLY_REFUNDED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  ONLINE
  COUNTER
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  INACTIVE
}

// ----------------------------------------------------
// Models
// ----------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  phone        String?
  isActive     Boolean  @default(true)
  tokenVersion Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships        RestaurantMembership[]
  orderStatusUpdates OrderStatusHistory[]
  cancelledOrderItems OrderItem[] @relation("CancelledOrderItems")
  completedOrderRefunds Order[]   @relation("CompletedOrderRefunds")
  closedTableSessions TableSession[] @relation("ClosedTableSessions")

  @@map("users")
}

model Restaurant {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  address     String?
  phone       String?
  currency    String   @default("INR")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships RestaurantMembership[]
  categories  MenuCategory[]
  menuItems   MenuItem[]
  tables      RestaurantTable[]
  qrTokens    TableQrToken[]
  sessions    TableSession[]
  orders      Order[]
  payments    Payment[]
  billingConfig RestaurantBillingConfig?
  invoices    Invoice[]

  @@map("restaurants")
}

model RestaurantMembership {
  id           String   @id @default(uuid())
  userId       String
  restaurantId String
  role         UserRole @default(MANAGER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
  @@index([restaurantId, role])
  @@map("restaurant_memberships")
}

model MenuCategory {
  id           String   @id @default(uuid())
  restaurantId String
  name         String
  description  String?
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems  MenuItem[]

  @@unique([restaurantId, name])
  @@index([restaurantId, isActive])
  @@map("menu_categories")
}

model MenuItem {
  id           String   @id @default(uuid())
  restaurantId String
  categoryId   String
  name         String
  description  String?
  price        Int // Stored in minor currency units (e.g. paise)
  imageUrl     String?
  isAvailable  Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]

  @@index([restaurantId, isAvailable])
  @@index([categoryId])
  @@map("menu_items")
}

model RestaurantTable {
  id           String      @id @default(uuid())
  restaurantId String
  tableNumber  String
  capacity     Int         @default(4)
  status       TableStatus @default(AVAILABLE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  restaurant Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  qrTokens   TableQrToken[]
  sessions   TableSession[]
  orders     Order[]

  @@unique([restaurantId, tableNumber])
  @@index([restaurantId, status])
  @@map("restaurant_tables")
}

model TableQrToken {
  id           String    @id @default(uuid())
  restaurantId String
  tableId      String
  tokenHash    String    @unique
  isRevoked    Boolean   @default(false)
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  restaurant Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table      RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([restaurantId, tableId])
  @@index([tokenHash, isRevoked])
  @@map("table_qr_tokens")
}

model TableSession {
  id               String    @id @default(uuid())
  restaurantId     String
  tableId          String
  sessionTokenHash String    @unique
  expiresAt        DateTime
  isActive         Boolean   @default(true)
  status           String    @default("ACTIVE")
  closedAt         DateTime?
  closedByUserId   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table        RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  closedByUser User?           @relation("ClosedTableSessions", fields: [closedByUserId], references: [id], onDelete: SetNull)
  orders       Order[]

  @@index([restaurantId, tableId, isActive])
  @@index([restaurantId, tableId, status])
  @@map("table_sessions")
}

model Order {
  id             String        @id @default(uuid())
  restaurantId   String
  tableId        String
  sessionId      String?
  orderNumber    String
  orderStatus    OrderStatus   @default(PENDING)
  paymentStatus  PaymentStatus @default(UNPAID)
  paymentMethod  PaymentMethod
  subtotal       Int // in minor units
  tax            Int           @default(0) // in minor units
  total          Int // in minor units
  cgst           Int           @default(0) // in minor units
  sgst           Int           @default(0) // in minor units
  igst           Int           @default(0) // in minor units
  serviceCharge  Int           @default(0) // in minor units
  packagingCharge Int          @default(0) // in minor units
  customCharge   Int           @default(0) // in minor units
  discountAmount Int           @default(0) // in minor units
  taxableAmount  Int           @default(0) // in minor units
  billingSnapshot Json?
  invoiceNumber  String?
  refundAmount            Int           @default(0) // in minor units
  refundedAtCounterAmount Int           @default(0) // in minor units
  refundStatus            String?
  refundCompletedAt       DateTime?
  refundCompletedByUserId String?
  notes                   String?
  idempotencyKey          String?       @unique
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  restaurant            Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  table                 RestaurantTable      @relation(fields: [tableId], references: [id], onDelete: Restrict)
  session               TableSession?        @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  refundCompletedByUser User?                @relation("CompletedOrderRefunds", fields: [refundCompletedByUserId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  payments      Payment[]
  statusHistory OrderStatusHistory[]
  invoice       Invoice?

  @@unique([restaurantId, orderNumber])
  @@index([restaurantId, orderStatus])
  @@index([restaurantId, createdAt])
  @@map("orders")
}

model OrderItem {
  id                String          @id @default(uuid())
  orderId           String
  menuItemId        String?
  nameSnapshot      String
  priceSnapshot     Int // minor units
  quantity          Int
  totalPrice        Int // minor units
  notes             String?
  status            OrderItemStatus @default(ACTIVE)
  cancelReason      String?
  cancelNote        String?
  cancelledAt       DateTime?
  cancelledByUserId String?
  createdAt         DateTime        @default(now())

  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem        MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  cancelledByUser User?     @relation("CancelledOrderItems", fields: [cancelledByUserId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([orderId, status])
  @@map("order_items")
}

model Payment {
  id                   String        @id @default(uuid())
  restaurantId         String
  orderId              String
  amount               Int // minor units
  refundAmount         Int           @default(0) // minor units
  currency             String        @default("INR")
  method               PaymentMethod
  status               PaymentStatus @default(PENDING)
  refundStatus         String?
  gatewayProvider      String?
  gatewayTransactionId String?
  gatewayOrderId       String?
  gatewayRefundId      String?
  paidAt               DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  restaurant Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  order      Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events     PaymentEvent[]

  @@index([restaurantId, status])
  @@index([orderId])
  @@index([gatewayOrderId])
  @@index([gatewayTransactionId])
  @@map("payments")
}

model PaymentEvent {
  id          String   @id @default(uuid())
  paymentId   String?
  provider    String
  eventId     String   @unique
  eventType   String
  payload     Json
  processedAt DateTime @default(now())

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([provider, eventId])
  @@map("payment_events")
}

model OrderStatusHistory {
  id              String       @id @default(uuid())
  orderId         String
  fromStatus      OrderStatus?
  toStatus        OrderStatus
  changedByUserId String?
  note            String?
  createdAt       DateTime     @default(now())

  order         Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedByUser User? @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_status_history")
}

model RestaurantBillingConfig {
  id                    String   @id @default(uuid())
  restaurantId          String   @unique
  legalName             String?
  displayName           String?
  gstin                 String?
  address               String?
  state                 String?  @default("Maharashtra")
  stateCode             String?  @default("27")
  phone                 String?
  email                 String?
  invoicePrefix         String   @default("INV-")
  invoiceNextNumber     Int      @default(1001)
  invoiceNumberPadding  Int      @default(4)
  gstEnabled            Boolean  @default(false)
  taxInclusive          Boolean  @default(false)
  gstRate               Int      @default(500) // in basis points (500 = 5.00%)
  cgstRate              Int      @default(250) // in basis points (250 = 2.50%)
  sgstRate              Int      @default(250) // in basis points (250 = 2.50%)
  igstRate              Int      @default(500) // in basis points (500 = 5.00%)
  serviceChargeEnabled  Boolean  @default(false)
  serviceChargeRate     Int      @default(0) // in basis points (e.g. 500 = 5%) or minor units if fixed
  serviceChargeType     String   @default("PERCENTAGE") // PERCENTAGE | FIXED
  serviceChargeTaxable  Boolean  @default(true)
  packagingChargeEnabled Boolean @default(false)
  packagingChargeAmount Int      @default(0) // in minor units paise
  packagingChargeType   String   @default("FIXED") // FIXED | PERCENTAGE
  packagingChargeTaxable Boolean @default(true)
  customChargeName      String?
  customChargeEnabled   Boolean  @default(false)
  customChargeAmount    Int      @default(0) // in minor units paise
  customChargeType      String   @default("FIXED") // FIXED | PERCENTAGE
  customChargeTaxable   Boolean  @default(false)
  defaultDiscountType   String   @default("PERCENTAGE") // PERCENTAGE | FIXED
  maxDiscountPercent    Int      @default(100)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_billing_configs")
}

model Invoice {
  id              String   @id @default(uuid())
  restaurantId    String
  orderId         String   @unique
  invoiceNumber   String
  subtotal        Int // in minor units
  discountAmount  Int      @default(0) // in minor units
  taxableAmount   Int // in minor units
  cgst            Int      @default(0) // in minor units
  sgst            Int      @default(0) // in minor units
  igst            Int      @default(0) // in minor units
  totalTax        Int      @default(0) // in minor units
  serviceCharge   Int      @default(0) // in minor units
  packagingCharge Int      @default(0) // in minor units
  customCharge    Int      @default(0) // in minor units
  totalAmount     Int // in minor units
  currency        String   @default("INR")
  billingSnapshot Json
  customerPhone   String?
  generatedAt     DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order      Order      @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([restaurantId, invoiceNumber])
  @@index([restaurantId, invoiceNumber])
  @@index([restaurantId, generatedAt])
  @@map("invoices")
}
